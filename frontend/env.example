# Environment Variables for Frontend

# Backend API URL (replace with your actual backend URL)
NEXT_PUBLIC_API_URL=https://adminbackendnew-vawg.vercel.app

# Live payment API URL. Keep /payment/api/v1/payments/ to use Next.js rewrite proxy.
NEXT_PUBLIC_PAYMENT_API_URL=/payment/api/v1/payments/

# Optional: Add other frontend-specific environment variables here
NEXT_PUBLIC_APP_NAME=eChannelling
NEXT_PUBLIC_APP_VERSION=1.0.0
