{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --include=dev --include=optional",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/.next",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  }
}
